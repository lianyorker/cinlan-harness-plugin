{
  "name": "@cinlan/knowledge-core",
  "version": "0.1.0",
  "type": "module",
  "description": "cinlan-knowledge 核心：SQLite 存储、迁移、标识与身份原语",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/test/*.test.js\""
  },
  "dependencies": {
    "@cinlan/knowledge-sdk": "workspace:*",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
