{
  "name": "cinlan-harness",
  "title": "Cinlan Harness",
  "mcp": {
    "file": "~/.clh/cordis.patch.yml",
    "format": "yaml",
    "key": "cinlan-knowledge",
    "insert": true,
    "plugin": "@deepseek-ai/dsh-mcp-client"
  },
  "hook": null,
  "instructions": "full",
  "budgets": {
    "instructions": { "budget_chars": 12000, "max_bytes": 24000 }
  },
  "skill_dir": "~/.agents/skills",
  "import_scan": [
    "<workspace>/.clh/skills",
    "<workspace>/.agents/skills",
    "$CLH_HOME/skills",
    "~/.agents/skills"
  ]
}
