  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/test/*.test.js\""
  },
  "dependencies": {
    "@cinlan/knowledge-core": "workspace:*",
