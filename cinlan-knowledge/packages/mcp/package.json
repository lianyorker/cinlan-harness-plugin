{
  "name": "@cinlan/knowledge-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "cinlan-knowledge MCP 面：五个工具的唯一实现，hub 的 /mcp 与 ck mcp 共用",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "lib/index.js",
