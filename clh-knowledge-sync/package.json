{
  "name": "@cinlan/clh-knowledge-sync",
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-instance memory & skills sharing for Cinlan/DeepSeek Harness: node sync plugin + approvable central hub",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./hub": {
      "types": "./lib/hub/main.d.ts",
      "default": "./lib/hub/main.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "clh-knowledge-sync-hub": "./bin/hub.js",
    "clh-knowledge-sync": "./bin/clh-knowledge-sync.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "bin/*.js",
    "cordis.patch.yml",
    "client.js",
    "config/*.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
